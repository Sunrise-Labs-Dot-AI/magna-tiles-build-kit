+#[cfg(all(feature = "dim3",feature="alloc"))]
+pub struct PolyhedralGeometry {
+    pub points: Vec<Point<Real>>,
+    pub normals: Vec<Vector<Real>>,
+    pub edges: Vec<Vector<Real>>,
+}
+
+#[cfg(all(feature = "dim3",feature="alloc"))]
+impl PolyhedralGeometry {
+    pub fn directed_gap(&self, other:&Self, axis:&Vector<Real>) -> Real {
+        let a=self.points.iter().map(|p|p.coords.dot(axis)).fold(-Real::MAX,Real::max);
+        let b=other.points.iter().map(|p|p.coords.dot(axis)).fold(Real::MAX,Real::min);
+        b-a
+    }
+    pub fn contains_point(&self, point:&Point<Real>, margin:Real) -> bool {
+        self.normals.iter().all(|n| {
+            let (lo,hi)=self.points.iter().map(|p|p.coords.dot(n)).fold((Real::MAX,-Real::MAX),|(lo,hi),x|(lo.min(x),hi.max(x)));
+            let value=point.coords.dot(n);value>=lo-margin && value<=hi+margin
+        })
+    }
+    pub fn relative(&self, pose:&crate::math::Isometry<Real>) -> Self {
+        Self { points:self.points.iter().map(|p|pose*p).collect(),
+            normals:self.normals.iter().map(|n|pose*n).collect(),
+            edges:self.edges.iter().map(|e|pose*e).collect() }
+    }
+    pub fn separation(&self, other:&Self, margin:Real) -> (Real,Unit<Vector<Real>>) {
+        let center=|p:&Self|p.points.iter().map(|p|p.coords).sum::<Vector<Real>>()/p.points.len() as Real;
+        let delta=center(other)-center(self);
+        let mut best=(-Real::MAX,Vector::x_axis());
+        let axes=self.normals.iter().chain(other.normals.iter()).copied().chain(
+            self.edges.iter().flat_map(|a|other.edges.iter().map(move |b|a.cross(b))));
+        for axis in axes {
+            // Keep near-parallel separating axes; skip only exact zero vectors.
+            let Some(n)=Unit::try_new(axis,0.0) else {continue};
+            let forward=self.directed_gap(other,&n);
+            let backward=self.directed_gap(other,&-n);
+            let (gap,n)=if backward>forward || (backward==forward && delta.dot(&n)<0.0) {(backward,-n)} else {(forward,n)};
+            if gap>best.0+margin {best=(gap,n);}
+        }
+        best
+    }
