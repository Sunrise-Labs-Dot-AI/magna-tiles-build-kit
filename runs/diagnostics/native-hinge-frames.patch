+    // #if DIM3
+    /** A native free hinge with immutable, independent body-local frames. */
+    public static revoluteFrames(anchor1: Vector, frame1: Rotation, anchor2: Vector, frame2: Rotation): JointData {
+        for (const anchor of [anchor1,anchor2]) {
+            if (![anchor.x,anchor.y,anchor.z].every(Number.isFinite)) throw new Error("Invalid hinge anchor");
+        }
+        for (const frame of [frame1,frame2]) {
+            if (![frame.x,frame.y,frame.z,frame.w].every(Number.isFinite) || Math.abs(Math.hypot(frame.x,frame.y,frame.z,frame.w)-1)>1e-5) throw new Error("Invalid hinge frame");
+        }
+        const res=new JointData();res.anchor1=anchor1;res.anchor2=anchor2;res.frame1=frame1;res.frame2=frame2;res.jointType=JointType.Revolute;
+        return res;
+    }
+    // #endif
